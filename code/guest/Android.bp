package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "frameworks_native_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    // default_applicable_licenses: ["frameworks_native_license"],
}

cc_library_shared {
    // Real drivers would set this to vulkan.$(TARGET_BOARD_PLATFORM)
    name: "vulkan.express",
    proprietary: true,
    relative_install_path: "hw",

    clang: true,
    cflags: [
        "-fvisibility=hidden",
        "-fstrict-aliasing",
        "-DLOG_TAG=\"vknulldrv\"",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",

        "-DLOG_NDEBUG=0",
    ],

    include_dirs: [
        "vendor/vsoc/dcodec/include",
        "vendor/vsoc/express_gralloc",
    ],

    srcs: [
        "all_out_vk.cpp",
        "express_vk_flime_guest.cpp",
        "express_vk_flime_guest_core.cpp",
        "express_vk_flime_guest_descriptor.cpp",
        "express_vk_flime_guest_command.cpp",
        "all_out_vk_gen.cpp",
        "express_vk_deepcopy_guest.cpp",
        "express_vk_extension_structs_guest.cpp",
        "express_vk_counting_guest.cpp",
        "express_vk_encode_to_stream.cpp"
    ],

    header_libs: [
        "hwvulkan_headers",
        "vulkan_headers",
    ],
    shared_libs: ["liblog"],
}
